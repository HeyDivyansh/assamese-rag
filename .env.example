# ============================================================
# Assamese RAG — environment configuration
# Copy to `.env` and fill in the blanks.
# ============================================================

# --- Sarvam AI (STT: saaras:v3, LLM: sarvam-30b, Vision OCR fallback) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-30b

# --- PostgreSQL ---
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/assamese_rag

# --- Qdrant (dense vectors) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=assamese_doc_chunks

# --- OpenSearch (BM25) ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=assamese_doc_chunks_bm25
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- S3 / object storage (MinIO for local) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=assamese-rag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_HARD_DELETE_ON_DOC_DELETE=false

# --- Hugging Face Inference API (embeddings + reranker) ---
# When set, worker + API call HF — no local BGE-M3 / reranker weights in containers.
HF_TOKEN=
BGE_M3_MODEL_PATH_OR_ENDPOINT=BAAI/bge-m3
BGE_M3_DIM=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_PARALLEL_WORKERS=4
BGE_RERANKER_MODEL_PATH_OR_ENDPOINT=BAAI/bge-reranker-v2-m3

# --- OCR engine selection ---
OCR_PRIMARY_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=sarvam_vision
OCR_CONFIDENCE_THRESHOLD=0.60

# --- Chunking (P0/P2) ---
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=512
CHUNK_MIN_TOKENS=50
CHUNK_OVERLAP_TOKENS=50
UNICODE_QUALITY_THRESHOLD=0.45
DEFAULT_DOCUMENT_LANGUAGE=as

# --- Retrieval (P3) ---
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_TOP_K=20
RRF_K=60
MMR_TOP_K=20
MMR_LAMBDA=0.7
RERANK_INPUT_TOP_K=20
RERANK_TOP_K=5
CONTEXT_MAX_TOKENS=3000
DEBUG_RETRIEVAL=false
CONVERSATION_MEMORY_TURNS=6

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
